---
// src/components/ChannelBanner.astro
---

<a
  href="https://www.youtube.com/@ProfessorJustinLorieau"
  target="_blank"
  rel="noopener noreferrer"
  class="channel-spotlight-card not-content"
  title="Visit @ProfessorJustinLorieau on YouTube"
>
  <div class="channel-flex-wrap">
    <!-- Channel Avatar Thumbnail from YouTube -->
    <div class="channel-avatar-wrap">
      <img
        src="/channel-avatar.jpg"
        alt="Professor Justin Lorieau YouTube Avatar"
        class="channel-avatar-img"
        width="80"
        height="80"
      />
      <span class="avatar-play-icon">▶</span>
    </div>

    <!-- Channel Text Info -->
    <div class="channel-text-col">
      <div class="channel-badge-row">
        <span class="channel-badge-pill">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <path d="M23.5 6.2A3 3 0 0 0 21.4 4c-1.9-.5-9.4-.5-9.4-.5s-7.5 0-9.4.5A3 3 0 0 0 .5 6.3C0 8 0 12 0 12s0 4 .5 5.8A3 3 0 0 0 2.6 20c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2c.5-2 .5-5.9.5-5.9s0-4-.5-5.8zm-14 9.4V8.4l6.3 3.6-6.3 3.6z"/>
          </svg>
          Official YouTube Channel
        </span>
        <span class="channel-handle">
          @ProfessorJustinLorieau
        </span>
      </div>

      <h1 class="channel-title">Professor Justin Lorieau</h1>

      <p class="channel-description">
        Visual video textbook with companion problem sets in math, physics, chemistry, thermodynamics and quantum mechanics. Created from my university lectures.
      </p>
    </div>

    <!-- CTA Column -->
    <div class="channel-cta-col">
      <span class="channel-sub-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M8 5v14l11-7z" />
        </svg>
        Visit Channel on YouTube ↗
      </span>
    </div>
  </div>
</a>

<style>
  .channel-spotlight-card {
    display: block;
    margin: 0.25rem 0 1.25rem 0;
    padding: 1.15rem 1.5rem;
    border-radius: 14px;
    background: var(--qp-banner-bg);
    border: 1px solid var(--qp-banner-border);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.25);
    text-decoration: none !important;
    color: inherit;
    cursor: pointer;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .channel-spotlight-card:hover {
    transform: translateY(-2px);
    border-color: #ef4444;
    box-shadow: 0 8px 30px rgba(239, 68, 68, 0.22);
  }

  .channel-flex-wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
  }

  /* Avatar from YouTube */
  .channel-avatar-wrap {
    position: relative;
    display: block;
    width: 76px;
    height: 76px;
    border-radius: 50%;
    flex-shrink: 0;
    overflow: hidden;
    border: 2.5px solid #ef4444;
    box-shadow: 0 0 16px rgba(239, 68, 68, 0.4);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .channel-spotlight-card:hover .channel-avatar-wrap {
    transform: scale(1.05);
    box-shadow: 0 0 24px rgba(239, 68, 68, 0.6);
  }

  .channel-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .avatar-play-icon {
    position: absolute;
    bottom: 2px;
    right: 2px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #ef4444;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.65rem;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.6);
  }

  /* Info Column */
  .channel-text-col {
    flex: 1 1 360px;
    min-width: 0;
  }

  .channel-badge-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 0.25rem;
  }

  .channel-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    background: var(--qp-badge-red-bg);
    color: var(--qp-badge-red-text);
    border: 1px solid var(--qp-badge-red-border);
  }

  .channel-handle {
    font-size: 0.85rem;
    font-family: var(--sl-font-mono);
    color: var(--sl-color-gray-3) !important;
    text-decoration: none !important;
    transition: color 0.15s ease;
  }

  .channel-spotlight-card:hover .channel-handle {
    color: var(--qp-badge-red-text) !important;
    text-decoration: underline !important;
  }

  .channel-title {
    margin: 0.15rem 0 0.35rem 0 !important;
    font-size: 1.45rem !important;
    font-weight: 800 !important;
    line-height: 1.2 !important;
    color: var(--sl-color-white) !important;
    letter-spacing: -0.01em;
  }

  .channel-description {
    font-size: 0.88rem;
    color: var(--sl-color-gray-2);
    line-height: 1.45;
    margin: 0 !important;
  }

  /* CTA Button */
  .channel-cta-col {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.35rem;
    flex-shrink: 0;
    margin-left: auto;
  }

  .channel-sub-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.25rem;
    border-radius: 9999px;
    background: #ef4444;
    color: #ffffff !important;
    font-weight: 700;
    font-size: 0.88rem;
    text-decoration: none !important;
    box-shadow: 0 4px 14px rgba(239, 68, 68, 0.35);
    white-space: nowrap;
    transition: transform 0.15s ease, background 0.15s ease;
  }

  .channel-spotlight-card:hover .channel-sub-btn {
    background: #dc2626;
    transform: translateY(-1px);
  }

  @media (max-width: 768px) {
    .channel-cta-col {
      align-items: flex-start;
      margin-left: 0;
      width: 100%;
    }
  }
</style>
