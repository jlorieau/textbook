---
// src/components/BookStream.astro
import type { BookData } from '../types/book';
import ChapterRow from './ChapterRow.astro';
import ChannelBanner from './ChannelBanner.astro';
import BookReferences from './BookReferences.astro';

interface Props {
  book: BookData;
}

const { book } = Astro.props;

// Collect tracking slugs for progress calculation
const allTrackingSlugs = book.chapters.flatMap((ch, idx) => {
  const slugs = [`${book.id}-ch${idx + 1}-${ch.id}`];
  if (ch.problemSet) {
    slugs.push(`${book.id}-ps${idx + 1}-${ch.id}`);
  }
  return slugs;
});

const totalLectures = book.chapters.length;
const totalProblemSets = book.chapters.filter((ch) => Boolean(ch.problemSet)).length;
---

<div class={`book-stream-container not-content book-theme-${book.colorScheme}`} data-book-id={book.id}>
  <!-- Book Hero Banner -->
  <header class="book-hero-banner not-content">
    <div class="book-hero-layout">
      {book.coverImage && (
        <div class="book-hero-cover-wrap">
          <img
            src={book.coverImage}
            alt={`${book.title} Cover`}
            class="book-hero-cover-img"
            loading="eager"
            width="170"
            height="227"
          />
        </div>
      )}

      <div class="book-hero-content">
        <div class="book-hero-meta">
          <h1 class="book-main-title">{book.title}</h1>
          <p class="book-desc-text">{book.description}</p>
        </div>

        <div class="book-stats-grid">
          <div class="stat-pill">
            <span class="stat-val">{totalLectures}</span>
            <span class="stat-lbl">Lectures</span>
          </div>
          <div class="stat-pill">
            <span class="stat-val">{totalProblemSets}</span>
            <span class="stat-lbl">Problem Sets</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Interactive Overall Book Progress Bar -->
  <div class="book-overall-progress" id={`progress-panel-${book.id}`}>
    <div class="progress-info-row">
      <span class="progress-title-lbl">Overall Volume Mastery</span>
      <span class="progress-percent-lbl" id={`progress-text-${book.id}`}>0%</span>
    </div>
    <div class="progress-bar-track">
      <div class="progress-bar-fill" id={`progress-bar-${book.id}`}></div>
    </div>
    <div class="progress-counter-sub" id={`progress-count-${book.id}`}>
      0 of {allTrackingSlugs.length} modules completed
    </div>
  </div>

  <!-- Sequential Video Chapters -->
  <div class="sequential-chapters-list">
    {book.chapters.map((chapter, idx) => {
      const showPartHeading = chapter.part && (idx === 0 || book.chapters[idx - 1].part !== chapter.part);
      const partSlug = chapter.part ? 'part-' + chapter.part.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') : null;
      return (
        <Fragment key={chapter.id}>
          {showPartHeading && (
            <div class="book-part-divider">
              <h2 class="part-divider-title" id={partSlug}>{chapter.part}</h2>
            </div>
          )}
          <ChapterRow
            chapter={chapter}
            chapterNumber={idx + 1}
            bookId={book.id}
          />
        </Fragment>
      );
    })}
  </div>

  <!-- References & Further Reading Section -->
  {book.references && book.references.length > 0 && (
    <BookReferences book={book} />
  )}

  <!-- Main YouTube Channel Spotlight -->
  <ChannelBanner />
</div>

<style>
  .book-stream-container {
    width: 100%;
    margin-top: 1rem;
  }

  /* Section / Part Dividers */
  .book-part-divider {
    margin: 4.5rem 0 1.5rem 0;
    padding-top: 1.75rem;
    border-top: 2px solid var(--sl-color-gray-5);
    scroll-margin-top: calc(var(--sl-nav-height) + 2rem);
  }

  .part-divider-title {
    margin: 0 !important;
    font-size: 1.65rem;
    font-weight: 800;
    color: var(--sl-color-white);
    letter-spacing: -0.02em;
    scroll-margin-top: calc(var(--sl-nav-height) + 2rem);
  }

  /* Book Hero */
  .book-hero-banner {
    padding: 2rem 2.25rem;
    border-radius: 16px;
    background: var(--qp-hero-banner-bg);
    border: 1px solid var(--sl-color-gray-5);
    margin-bottom: 2rem;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
  }

  .book-hero-layout {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .book-hero-cover-wrap {
    width: 165px;
    flex-shrink: 0;
    aspect-ratio: 3 / 4;
    border-radius: 10px;
    overflow: hidden;
    background: #000000;
    border: 1.5px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.55);
  }

  .book-hero-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .book-hero-content {
    flex: 1 1 auto;
    min-width: 0;
  }

  @media (max-width: 768px) {
    .book-hero-layout {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }
    .book-hero-cover-wrap {
      width: 140px;
    }
  }

  .book-volume-badge {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.25rem 0.75rem;
    border-radius: 6px;
    background: var(--qp-badge-blue-bg);
    color: var(--qp-badge-blue-text);
    border: 1px solid var(--qp-badge-blue-border);
    margin-bottom: 0.75rem;
  }

  .book-theme-amber .book-volume-badge {
    background: var(--qp-badge-amber-bg);
    color: var(--qp-badge-amber-text);
    border-color: var(--qp-badge-amber-border);
  }

  .book-main-title {
    margin: 0 0 0.5rem 0 !important;
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--sl-color-white);
  }

  .book-desc-text {
    font-size: 0.98rem;
    color: var(--sl-color-gray-2);
    line-height: 1.6;
    max-width: 850px;
    margin: 0 0 1.5rem 0 !important;
  }

  .book-stats-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1rem;
  }

  .stat-pill {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.45rem 1rem;
    border-radius: 8px;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-5);
  }

  .stat-val {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--sl-color-white);
  }

  .stat-lbl {
    font-size: 0.82rem;
    color: var(--sl-color-gray-3);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* Overall Progress */
  .book-overall-progress {
    margin: 1.5rem 0 2rem 0;
    padding: 1.25rem 1.5rem;
    border-radius: 12px;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-5);
  }

  .progress-info-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
    font-weight: 700;
  }

  .progress-title-lbl {
    font-size: 0.92rem;
    color: var(--sl-color-gray-2);
  }

  .progress-percent-lbl {
    font-size: 1.1rem;
    color: #10b981;
    font-family: var(--sl-font-mono);
  }

  .progress-bar-track {
    width: 100%;
    height: 10px;
    background: var(--sl-color-gray-5);
    border-radius: 9999px;
    overflow: hidden;
  }

  .progress-bar-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #38bdf8 0%, #10b981 100%);
    border-radius: 9999px;
    transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .book-theme-amber .progress-bar-fill {
    background: linear-gradient(90deg, #fbbf24 0%, #10b981 100%);
  }

  .progress-counter-sub {
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
    margin-top: 0.4rem;
  }
</style>

<script define:vars={{ bookId: book.id, slugs: allTrackingSlugs }}>
  function updateBookOverallProgress() {
    const total = slugs.length;
    if (total === 0) return;

    let completed = 0;
    slugs.forEach((slug) => {
      if (localStorage.getItem(`qp_watched_${slug}`) === 'true') {
        completed++;
      }
    });

    const percent = Math.round((completed / total) * 100);
    const bar = document.getElementById(`progress-bar-${bookId}`);
    const text = document.getElementById(`progress-text-${bookId}`);
    const count = document.getElementById(`progress-count-${bookId}`);

    if (bar) bar.style.width = `${percent}%`;
    if (text) text.textContent = `${percent}%`;
    if (count) count.textContent = `${completed} of ${total} modules completed`;
  }

  updateBookOverallProgress();
  window.addEventListener('qp:progress-update', updateBookOverallProgress);
  document.addEventListener('astro:page-load', updateBookOverallProgress);
</script>
