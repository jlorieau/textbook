---
// src/components/ChapterRow.astro
import type { ChapterData } from '../types/book';

interface Props {
  chapter: ChapterData;
  chapterNumber: number;
  bookId: string;
}

const { chapter, chapterNumber, bookId } = Astro.props;
const hasProblemSet = Boolean(chapter.problemSet);
const lectureSlug = `${bookId}-ch${chapterNumber}-${chapter.id}`;
const problemSetSlug = `${bookId}-ps${chapterNumber}-${chapter.id}`;

const psYouTubeUrl = chapter.problemSet?.youtubeId
  ? `https://youtu.be/${chapter.problemSet.youtubeId}`
  : null;
---

<section
  class={`chapter-row-wrapper not-content ${hasProblemSet ? 'has-ps' : 'solo-lecture'}`}
  data-chapter-id={chapter.id}
  data-chapter-number={chapterNumber}
>
  <!-- Chapter Header -->
  <div class="chapter-row-header">
    <div class="chapter-badge-title">
      <span class="chapter-number-pill">Chapter {chapterNumber}</span>
      <h2 id={`ch-${chapterNumber}`} class="chapter-title-text">{chapter.title}</h2>
    </div>
    {chapter.duration && (
      <span class="chapter-time-pill">⏱ {chapter.duration}</span>
    )}
  </div>

  <p class="chapter-summary-text">{chapter.summary}</p>

  <!-- Full-Width Lecture Video Card -->
  <div class="video-card lecture-card" data-slug={lectureSlug}>
    <div class="card-top-bar">
      <span class="video-type-badge lecture-badge">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
          <path d="M8 5v14l11-7z" />
        </svg>
        Main Concept Lecture
      </span>
      <div class="card-top-actions">
        {chapter.youtubeId && (
          <a
            href={`https://youtu.be/${chapter.youtubeId}`}
            target="_blank"
            rel="noopener noreferrer"
            class="yt-external-btn"
            title="Open lecture on YouTube"
          >
            YouTube ↗
          </a>
        )}
        <button
          type="button"
          class="track-btn track-lecture-btn"
          data-track-slug={lectureSlug}
          aria-pressed="false"
          title="Toggle lecture watch status"
        >
          <span class="track-icon">○</span>
          <span class="track-label">Mark Watched</span>
        </button>
      </div>
    </div>

    <!-- Full-width 16:9 embedded player -->
    {chapter.youtubeId ? (
      <div
        class="video-embed-container"
        id={`player-wrap-${lectureSlug}`}
        data-video-id={chapter.youtubeId}
        data-track-slug={lectureSlug}
      >
        <iframe
          id={`yt-frame-${lectureSlug}`}
          src={`https://www.youtube.com/embed/${chapter.youtubeId}?enablejsapi=1&rel=0&playsinline=1&modestbranding=1`}
          title={`Lecture: ${chapter.title}`}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
        ></iframe>
      </div>
    ) : (
      <div class="video-preview-placeholder">
        <div class="placeholder-icon">🎬</div>
        <div class="placeholder-text">Lecture Video in Final Production</div>
        <div class="placeholder-sub">Script and Manim animations completed. Releasing soon on YouTube!</div>
      </div>
    )}

    <!-- Timestamps below the video -->
    {chapter.timestamps && chapter.timestamps.length > 0 && (
      <div class="chapter-derivation-timestamps">
        <div class="timestamp-section-title">Sections</div>
        <div class="timestamp-pill-wrap">
          {chapter.timestamps.map((ts) => (
            <button
              type="button"
              class="timestamp-pill"
              data-seconds={ts.seconds}
              data-slug={lectureSlug}
              data-player-wrap={`player-wrap-${lectureSlug}`}
              title={`Jump to ${ts.label} (${ts.time})`}
            >
              <span class="ts-time">{ts.time}</span>
              <span class="ts-label">{ts.label}</span>
            </button>
          ))}
        </div>
      </div>
    )}
  </div>

  <!-- Companion Problem Set: Ultra-Compact 1-2 Line Card -->
  {hasProblemSet && chapter.problemSet && (
    <div class="companion-problemset-compact" data-slug={problemSetSlug}>
      <!-- Line 1: Identity & Action Buttons -->
      <div class="ps-compact-row">
        <div class="ps-compact-identity">
          <span class="ps-compact-badge">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
              <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
            </svg>
            Problem Set:
          </span>
          <span class="ps-compact-title">{chapter.problemSet.title}</span>
          {chapter.problemSet.duration && (
            <span class="ps-compact-time">({chapter.problemSet.duration})</span>
          )}
        </div>

        <div class="ps-compact-actions">
          {chapter.problemSet?.youtubeId && (
            <button
              type="button"
              class="ps-play-embed-btn"
              data-slug={problemSetSlug}
              data-player-wrap={`player-wrap-${problemSetSlug}`}
              title="Play problem set solutions embedded"
            >
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                <path d="M8 5v14l11-7z" />
              </svg>
              <span class="ps-play-btn-text">Play Video</span>
            </button>
          )}
          {psYouTubeUrl && (
            <a
              href={psYouTubeUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="ps-compact-yt-btn"
              title={`Watch "${chapter.problemSet.title}" on YouTube`}
            >
              YouTube ↗
            </a>
          )}
          <button
            type="button"
            class="track-btn track-ps-btn track-compact-btn"
            data-track-slug={problemSetSlug}
            aria-pressed="false"
            title="Toggle problem set solved status"
          >
            <span class="track-icon">○</span>
            <span class="track-label">Mark Solved</span>
          </button>
        </div>
      </div>

      <!-- Embedded Problem Set Player Slot -->
      {chapter.problemSet?.youtubeId && (
        <div
          class="ps-embed-container"
          id={`player-wrap-${problemSetSlug}`}
          data-video-id={chapter.problemSet.youtubeId}
          data-track-slug={problemSetSlug}
          style="display: none;"
        >
          <div class="ps-embed-aspect">
            <iframe
              id={`yt-frame-${problemSetSlug}`}
              src={`https://www.youtube.com/embed/${chapter.problemSet.youtubeId}?enablejsapi=1&rel=0&playsinline=1&modestbranding=1`}
              title={`Problem Set: ${chapter.problemSet.title}`}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            ></iframe>
          </div>
        </div>
      )}

      <!-- Line 2: Expandable Timestamps Section -->
      {chapter.problemSet.timestamps && chapter.problemSet.timestamps.length > 0 && (
        <details class="ps-compact-details">
          <summary class="ps-compact-summary">
            <span class="summary-label">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              Problem Timestamps ({chapter.problemSet.timestamps.length})
            </span>
            <span class="summary-chevron">▾</span>
          </summary>
          <div class="ps-compact-drawer">
            {chapter.problemSet.summary && (
              <p class="ps-drawer-desc">{chapter.problemSet.summary}</p>
            )}
            <div class="ps-timestamps-grid">
              {chapter.problemSet.timestamps.map((ts) => (
                chapter.problemSet?.youtubeId && ts.seconds > 0 ? (
                  <button
                    type="button"
                    class="ps-ts-chip"
                    data-seconds={ts.seconds}
                    data-slug={problemSetSlug}
                    data-player-wrap={`player-wrap-${problemSetSlug}`}
                    title={`Jump to ${ts.label} (${ts.time})`}
                  >
                    <span class="ts-chip-time">{ts.time}</span>
                    <span class="ts-chip-label">{ts.label}</span>
                  </button>
                ) : (
                  <div class="ps-ts-chip pending">
                    <span class="ts-chip-time">{ts.time}</span>
                    <span class="ts-chip-label">{ts.label}</span>
                  </div>
                )
              ))}
            </div>
          </div>
        </details>
      )}
    </div>
  )}
</section>

<style>
  .chapter-row-wrapper {
    margin: 2.5rem 0 3.5rem 0;
    padding: 1.5rem;
    border-radius: 14px;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-5);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.12);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .chapter-row-wrapper:hover {
    border-color: rgba(56, 189, 248, 0.4);
    box-shadow: 0 6px 30px rgba(0, 0, 0, 0.2);
  }

  .chapter-row-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
    padding-bottom: 0.75rem;
  }

  .chapter-badge-title {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .chapter-number-pill {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.65rem;
    border-radius: 6px;
    background: rgba(2, 132, 199, 0.18);
    color: #38bdf8;
    border: 1px solid rgba(2, 132, 199, 0.35);
  }

  .chapter-title-text {
    margin: 0 !important;
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--sl-color-white);
    scroll-margin-top: calc(var(--sl-nav-height) + 1.5rem);
  }

  .chapter-time-pill {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--sl-color-gray-3);
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    background: var(--sl-color-gray-5);
  }

  .chapter-summary-text {
    font-size: 0.96rem;
    color: var(--sl-color-gray-2);
    margin: 0.5rem 0 1.25rem 0;
    line-height: 1.55;
  }

  /* Full-width Video Card */
  .video-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 12px;
    overflow: hidden;
    padding: 1.25rem;
    transition: all 0.2s ease;
  }

  .video-card.is-watched {
    border-color: rgba(16, 185, 129, 0.5);
    background: rgba(16, 185, 129, 0.04);
  }

  .card-top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.85rem;
    gap: 0.5rem;
  }

  .video-type-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.25rem 0.6rem;
    border-radius: 5px;
  }

  .lecture-badge {
    background: rgba(239, 68, 68, 0.15);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.3);
  }

  /* Tracker Button & Actions */
  .card-top-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .yt-external-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--sl-color-gray-3);
    text-decoration: none !important;
    padding: 0.35rem 0.6rem;
    border-radius: 6px;
    border: 1px solid transparent;
    transition: all 0.15s ease;
  }

  .yt-external-btn:hover {
    color: var(--sl-color-white);
    background: var(--sl-color-gray-5);
    border-color: var(--sl-color-gray-4);
  }

  .track-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.75rem;
    border-radius: 6px;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    border: 1px solid var(--sl-color-gray-4);
    background: var(--sl-color-gray-5);
    color: var(--sl-color-gray-2);
    transition: all 0.15s ease;
  }

  .track-btn:hover {
    background: var(--sl-color-gray-4);
    color: var(--sl-color-white);
  }

  .track-btn.completed {
    background: rgba(16, 185, 129, 0.2);
    border-color: #10b981;
    color: #10b981;
  }

  @keyframes watchedCelebration {
    0% {
      transform: scale(1);
      box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
    }
    50% {
      transform: scale(1.04);
      box-shadow: 0 0 0 10px rgba(16, 185, 129, 0);
    }
    100% {
      transform: scale(1);
      box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
    }
  }

  .auto-completed-pulse {
    animation: watchedCelebration 0.8s ease-out;
  }

  /* 16:9 Full-Width Embedded Video */
  .video-embed-container {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 10px;
    overflow: hidden;
    background: #090d16;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .video-embed-container iframe,
  :global(.video-embed-container iframe) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  /* Placeholder for in-production videos */
  .video-preview-placeholder {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px dashed var(--sl-color-gray-4);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    text-align: center;
  }

  .placeholder-icon {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .placeholder-text {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--sl-color-gray-2);
  }

  .placeholder-sub {
    font-size: 0.85rem;
    color: var(--sl-color-gray-3);
    margin-top: 0.3rem;
  }

  /* Timestamps section under lecture */
  .chapter-derivation-timestamps {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-gray-5);
  }

  .timestamp-section-title {
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--sl-color-gray-3);
    margin-bottom: 0.6rem;
  }

  .timestamp-pill-wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .timestamp-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.35rem 0.7rem;
    margin: 0 !important;
    border-radius: 6px;
    background: var(--sl-color-gray-5);
    color: var(--sl-color-gray-2) !important;
    text-decoration: none !important;
    font-size: 0.84rem;
    cursor: pointer;
    border: 1px solid transparent;
    font-family: inherit;
    line-height: 1.2;
    box-sizing: border-box;
    transition: all 0.15s ease;
  }

  .timestamp-pill:hover,
  .timestamp-pill.is-active {
    background: var(--sl-color-accent);
    color: var(--sl-color-black) !important;
    border-color: var(--sl-color-accent);
  }

  .ts-time {
    display: inline-flex;
    align-items: center;
    font-family: var(--sl-font-mono);
    font-weight: 700;
    line-height: 1;
    color: var(--sl-color-accent);
  }

  .timestamp-pill:hover .ts-time,
  .timestamp-pill.is-active .ts-time {
    color: var(--sl-color-black);
  }

  .ts-label {
    display: inline-flex;
    align-items: center;
    line-height: 1.2;
    white-space: nowrap;
  }

  /* =========================================================
     COMPACT 1-2 LINE COMPANION PROBLEM SET CARD
     ========================================================= */
  .companion-problemset-compact {
    margin-top: 0.85rem;
    padding: 0.6rem 0.9rem;
    border-radius: 10px;
    background: rgba(245, 158, 11, 0.05);
    border: 1px solid rgba(245, 158, 11, 0.25);
    transition: all 0.2s ease;
  }

  .companion-problemset-compact.is-watched {
    border-color: rgba(16, 185, 129, 0.45);
    background: rgba(16, 185, 129, 0.04);
  }

  /* Line 1: Identity & Action Buttons */
  .ps-compact-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .ps-compact-identity {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-size: 0.88rem;
  }

  .ps-compact-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    background: rgba(245, 158, 11, 0.15);
    color: #fbbf24;
    border: 1px solid rgba(245, 158, 11, 0.3);
  }

  .ps-compact-title {
    font-weight: 700;
    color: var(--sl-color-white);
  }

  .ps-compact-time {
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font-mono);
  }

  .ps-compact-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .ps-play-embed-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    background: #f59e0b;
    color: #0f172a !important;
    font-size: 0.78rem;
    font-weight: 700;
    cursor: pointer;
    border: 1px solid #f59e0b;
    box-shadow: 0 1px 6px rgba(245, 158, 11, 0.25);
    transition: transform 0.15s ease, background 0.15s ease;
  }

  .ps-play-embed-btn:hover {
    background: #d97706;
    color: #ffffff !important;
    transform: translateY(-1px);
  }

  .ps-compact-yt-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.25rem 0.55rem;
    border-radius: 6px;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--sl-color-gray-3);
    text-decoration: none !important;
    border: 1px solid transparent;
    transition: all 0.15s ease;
  }

  .ps-compact-yt-btn:hover {
    color: var(--sl-color-white);
    background: var(--sl-color-gray-5);
    border-color: var(--sl-color-gray-4);
  }

  .track-compact-btn {
    padding: 0.25rem 0.6rem;
    font-size: 0.78rem;
  }

  .ps-embed-container {
    margin-top: 0.85rem;
    border-radius: 10px;
    overflow: hidden;
    background: #090d16;
    border: 1px solid rgba(245, 158, 11, 0.25);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }

  .ps-embed-aspect {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
  }

  .ps-embed-aspect iframe,
  :global(.ps-embed-aspect iframe) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  /* Line 2: Expandable Timestamps */
  .ps-compact-details {
    margin-top: 0.35rem;
    padding-top: 0.35rem;
    border-top: 1px dashed rgba(245, 158, 11, 0.18);
  }

  .ps-compact-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    list-style: none;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--sl-color-gray-3);
    padding: 0.15rem 0;
    user-select: none;
    transition: color 0.15s ease;
  }

  .ps-compact-summary::-webkit-details-marker {
    display: none;
  }

  .ps-compact-summary::marker {
    display: none;
  }

  .ps-compact-summary:hover {
    color: #fbbf24;
  }

  .summary-label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .summary-chevron {
    display: inline-block;
    font-size: 0.75rem;
    transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ps-compact-details[open] .summary-chevron {
    transform: rotate(180deg);
  }

  .ps-compact-drawer {
    margin-top: 0.5rem;
    padding: 0.6rem 0.75rem;
    border-radius: 6px;
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .ps-drawer-desc {
    font-size: 0.84rem;
    color: var(--sl-color-gray-2);
    line-height: 1.45;
    margin: 0 0 0.5rem 0 !important;
  }

  .ps-timestamps-grid {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  .ps-ts-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.65rem;
    margin: 0 !important;
    border-radius: 6px;
    background: rgba(245, 158, 11, 0.08);
    border: 1px solid rgba(245, 158, 11, 0.2);
    color: var(--sl-color-gray-2) !important;
    text-decoration: none !important;
    font-size: 0.82rem;
    cursor: pointer;
    font-family: inherit;
    line-height: 1.2;
    box-sizing: border-box;
    transition: all 0.15s ease;
  }

  .ps-ts-chip:hover,
  .ps-ts-chip.is-active {
    background: #f59e0b !important;
    color: #0f172a !important;
    border-color: #f59e0b !important;
  }

  .ts-chip-time {
    display: inline-flex;
    align-items: center;
    font-family: var(--sl-font-mono);
    font-weight: 700;
    line-height: 1;
    color: #fbbf24;
  }

  .ps-ts-chip:hover .ts-chip-time,
  .ps-ts-chip.is-active .ts-chip-time {
    color: #0f172a;
  }

  .ts-chip-label {
    display: inline-flex;
    align-items: center;
    line-height: 1.2;
    white-space: nowrap;
  }

  .ps-ts-chip.pending {
    opacity: 0.6;
    cursor: default;
  }

  .yt-error-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(15, 23, 42, 0.95);
    color: var(--sl-color-gray-2);
    padding: 1.5rem;
    text-align: center;
    z-index: 5;
    border-radius: 10px;
    gap: 0.75rem;
  }

  .yt-error-fallback p {
    margin: 0;
    font-size: 0.92rem;
    font-weight: 700;
    color: #fca5a5;
  }

  .yt-error-fallback-sub {
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
    max-width: 440px;
    line-height: 1.45;
  }

  .yt-error-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.95rem;
    border-radius: 6px;
    background: #ef4444;
    color: #ffffff !important;
    font-weight: 700;
    font-size: 0.85rem;
    text-decoration: none !important;
    box-shadow: 0 2px 10px rgba(239, 68, 68, 0.4);
    transition: background 0.15s ease;
  }

  .yt-error-btn:hover {
    background: #dc2626;
  }
</style>

<script>
  // Global YouTube IFrame API promise
  let ytApiPromise: Promise<any> | null = null;
  function getYouTubeAPI(): Promise<any> {
    if ((window as any).YT && (window as any).YT.Player) {
      return Promise.resolve((window as any).YT);
    }
    if (ytApiPromise) return ytApiPromise;

    ytApiPromise = new Promise((resolve) => {
      const checkInterval = setInterval(() => {
        if ((window as any).YT && (window as any).YT.Player) {
          clearInterval(checkInterval);
          resolve((window as any).YT);
        }
      }, 50);

      const prevOnReady = (window as any).onYouTubeIframeAPIReady;
      (window as any).onYouTubeIframeAPIReady = () => {
        if (prevOnReady) prevOnReady();
        clearInterval(checkInterval);
        resolve((window as any).YT);
      };

      if (!document.querySelector('script[src*="youtube.com/iframe_api"]')) {
        const tag = document.createElement('script');
        tag.src = 'https://www.youtube.com/iframe_api';
        tag.async = true;
        document.head.appendChild(tag);
      }
    });
    return ytApiPromise;
  }

  // Active player instances, timers, and pending seeks
  const activePlayers = new Map<string, any>();
  const activeTimers = new Map<string, any>();
  const pendingSeeks = new Map<string, number>();

  function markAsCompleted(slug: string) {
    const storageKey = `qp_watched_${slug}`;
    if (localStorage.getItem(storageKey) === 'true') {
      return;
    }
    localStorage.setItem(storageKey, 'true');

    const btn = document.querySelector<HTMLButtonElement>(`.track-btn[data-track-slug="${slug}"]`);
    const card = btn?.closest('.video-card, .companion-problemset-compact');
    const textSpan = btn?.querySelector('.track-label');
    const iconSpan = btn?.querySelector('.track-icon');
    const isPs = btn?.classList.contains('track-ps-btn');

    card?.classList.add('is-watched');
    btn?.classList.add('completed');
    btn?.setAttribute('aria-pressed', 'true');
    if (textSpan) textSpan.textContent = isPs ? 'Solved ✓' : 'Watched ✓';
    if (iconSpan) iconSpan.textContent = '●';

    btn?.classList.add('auto-completed-pulse');
    setTimeout(() => btn?.classList.remove('auto-completed-pulse'), 1500);

    window.dispatchEvent(
      new CustomEvent('qp:progress-update', {
        detail: { slug, isCompleted: true },
      })
    );
  }

  function handlePlayerStateChange(event: any, slug: string, player: any) {
    const YT = (window as any).YT;
    if (!YT) return;

    if (activeTimers.has(slug)) {
      clearInterval(activeTimers.get(slug));
      activeTimers.delete(slug);
    }

    // 1 = PLAYING
    if (event.data === YT.PlayerState.PLAYING) {
      const timer = setInterval(() => {
        try {
          if (!player || typeof player.getPlayerState !== 'function') {
            clearInterval(timer);
            return;
          }
          if (player.getPlayerState() !== YT.PlayerState.PLAYING) {
            clearInterval(timer);
            activeTimers.delete(slug);
            return;
          }
          const current = player.getCurrentTime();
          const duration = player.getDuration();
          // Auto-mark watched when reaching 90% or within last 10 seconds of the video
          if (duration > 0 && (current / duration >= 0.90 || duration - current <= 10)) {
            markAsCompleted(slug);
            clearInterval(timer);
            activeTimers.delete(slug);
          }
        } catch {
          clearInterval(timer);
        }
      }, 1500);
      activeTimers.set(slug, timer);
    } else if (event.data === YT.PlayerState.ENDED) {
      markAsCompleted(slug);
    }
  }

  function handlePlayerError(code: number, wrapElement: HTMLElement, videoId: string) {
    if (wrapElement.querySelector('.yt-error-fallback')) return;

    const notice = document.createElement('div');
    notice.className = 'yt-error-fallback';
    notice.innerHTML = `
      <p>⚠️ Embedded Playback Restricted (Error ${code})</p>
      <div class="yt-error-fallback-sub">
        YouTube restricts embedding in local preview (HTTP) or when an ad-blocker blocks player verification.
      </div>
      <a href="https://youtu.be/${videoId}" target="_blank" rel="noopener noreferrer" class="yt-error-btn">
        Watch on YouTube ↗
      </a>
    `;
    wrapElement.appendChild(notice);
  }

  function ensurePlayer(slug: string, startSeconds = 0): Promise<any> {
    if (activePlayers.has(slug)) {
      const player = activePlayers.get(slug);
      try {
        if (startSeconds > 0 && typeof player.seekTo === 'function') {
          player.seekTo(startSeconds, true);
        }
        if (typeof player.playVideo === 'function') {
          player.playVideo();
        }
      } catch (err) {
        console.warn('Error commanding player:', err);
      }
      return Promise.resolve(player);
    }

    if (startSeconds > 0) {
      pendingSeeks.set(slug, startSeconds);
    }

    return getYouTubeAPI().then((YT) => {
      const iframe = document.getElementById(`yt-frame-${slug}`) as HTMLIFrameElement;
      if (!iframe) return null;

      const wrapElement = iframe.closest('.video-embed-container, .ps-embed-container') as HTMLElement;
      const videoId = wrapElement?.getAttribute('data-video-id') || '';

      return new Promise((resolve) => {
        const player = new YT.Player(iframe.id, {
          events: {
            onReady: (event: any) => {
              const sec = pendingSeeks.get(slug);
              if (typeof sec === 'number' && sec > 0) {
                pendingSeeks.delete(slug);
                event.target.seekTo(sec, true);
                event.target.playVideo();
              }
              resolve(player);
            },
            onStateChange: (event: any) => {
              handlePlayerStateChange(event, slug, player);
            },
            onError: (event: any) => {
              console.warn(`[YouTube Player Error] Code: ${event.data} on ${slug}`);
              if (wrapElement && videoId) {
                handlePlayerError(event.data, wrapElement, videoId);
              }
              resolve(player);
            },
          },
        });
        activePlayers.set(slug, player);
      });
    });
  }

  function initVisiblePlayers() {
    getYouTubeAPI().then((YT) => {
      const iframes = document.querySelectorAll<HTMLIFrameElement>('iframe[id^="yt-frame-"]');
      iframes.forEach((iframe) => {
        const slug = iframe.id.replace('yt-frame-', '');
        if (activePlayers.has(slug)) return;

        // Skip hidden problem set iframes until they are opened
        const isHidden = iframe.closest('.ps-embed-container')?.getAttribute('style')?.includes('none');
        if (isHidden) return;

        const wrapElement = iframe.closest('.video-embed-container, .ps-embed-container') as HTMLElement;
        const videoId = wrapElement?.getAttribute('data-video-id') || '';

        const player = new YT.Player(iframe.id, {
          events: {
            onReady: (event: any) => {
              const sec = pendingSeeks.get(slug);
              if (typeof sec === 'number' && sec > 0) {
                pendingSeeks.delete(slug);
                event.target.seekTo(sec, true);
                event.target.playVideo();
              }
            },
            onStateChange: (event: any) => {
              handlePlayerStateChange(event, slug, player);
            },
            onError: (event: any) => {
              console.warn(`[YouTube Player Error] Code: ${event.data} on ${slug}`);
              if (wrapElement && videoId) {
                handlePlayerError(event.data, wrapElement, videoId);
              }
            },
          },
        });
        activePlayers.set(slug, player);
      });
    });
  }

  function setupChapterRowTrackers() {
    // 1. Setup manual toggle tracking buttons
    const buttons = document.querySelectorAll<HTMLButtonElement>('.track-btn');
    buttons.forEach((btn) => {
      const slug = btn.getAttribute('data-track-slug');
      if (!slug) return;

      const card = btn.closest('.video-card, .companion-problemset-compact');
      const textSpan = btn.querySelector('.track-label');
      const iconSpan = btn.querySelector('.track-icon');
      const isPs = btn.classList.contains('track-ps-btn');
      const storageKey = `qp_watched_${slug}`;

      function updateUI(completed: boolean) {
        if (completed) {
          card?.classList.add('is-watched');
          btn?.classList.add('completed');
          btn?.setAttribute('aria-pressed', 'true');
          if (textSpan) textSpan.textContent = isPs ? 'Solved ✓' : 'Watched ✓';
          if (iconSpan) iconSpan.textContent = '●';
        } else {
          card?.classList.remove('is-watched');
          btn?.classList.remove('completed');
          btn?.setAttribute('aria-pressed', 'false');
          if (textSpan) textSpan.textContent = isPs ? 'Mark Solved' : 'Mark Watched';
          if (iconSpan) iconSpan.textContent = '○';
        }
      }

      updateUI(localStorage.getItem(storageKey) === 'true');

      if (!btn.hasAttribute('data-bound')) {
        btn.setAttribute('data-bound', 'true');
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const current = localStorage.getItem(storageKey) === 'true';
          const next = !current;
          localStorage.setItem(storageKey, next ? 'true' : 'false');
          updateUI(next);

          window.dispatchEvent(
            new CustomEvent('qp:progress-update', {
              detail: { slug, isCompleted: next },
            })
          );
        });
      }
    });

    // 2. Setup problem set play / toggle buttons
    document.querySelectorAll<HTMLElement>('.ps-play-embed-btn').forEach((btn) => {
      if (btn.hasAttribute('data-bound')) return;
      btn.setAttribute('data-bound', 'true');

      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const slug = btn.getAttribute('data-slug') || btn.getAttribute('data-player-wrap')?.replace('player-wrap-', '');
        if (!slug) return;

        const wrap = document.getElementById(`player-wrap-${slug}`);
        if (!wrap) return;

        const isCurrentlyHidden = wrap.style.display === 'none';
        const labelSpan = btn.querySelector('.ps-play-btn-text');

        if (isCurrentlyHidden) {
          wrap.style.display = 'block';
          if (labelSpan) labelSpan.textContent = 'Hide Video';
          ensurePlayer(slug, 0);
          wrap.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        } else {
          const player = activePlayers.get(slug);
          if (player && typeof player.pauseVideo === 'function') {
            player.pauseVideo();
          }
          wrap.style.display = 'none';
          if (labelSpan) labelSpan.textContent = 'Play Video';
        }
      });
    });

    // 3. Setup timestamp pills & problem set chips
    document.querySelectorAll<HTMLElement>('.timestamp-pill, .ps-ts-chip').forEach((chip) => {
      if (chip.hasAttribute('data-bound')) return;
      chip.setAttribute('data-bound', 'true');

      chip.addEventListener('click', (e) => {
        e.preventDefault();
        const slug = chip.getAttribute('data-slug') || chip.getAttribute('data-player-wrap')?.replace('player-wrap-', '');
        const seconds = parseInt(chip.getAttribute('data-seconds') || '0', 10);
        if (!slug) return;

        const wrap = document.getElementById(`player-wrap-${slug}`);
        if (wrap && wrap.classList.contains('ps-embed-container') && wrap.style.display === 'none') {
          wrap.style.display = 'block';
          const parentComp = wrap.closest('.companion-problemset-compact');
          const psPlayBtn = parentComp?.querySelector('.ps-play-embed-btn .ps-play-btn-text');
          if (psPlayBtn) psPlayBtn.textContent = 'Hide Video';
        }

        const parentDetails = chip.closest('details');
        if (parentDetails && !parentDetails.open) {
          parentDetails.open = true;
        }

        ensurePlayer(slug, seconds);

        const siblingChips = chip.parentElement?.querySelectorAll('.timestamp-pill, .ps-ts-chip');
        siblingChips?.forEach((c) => c.classList.remove('is-active'));
        chip.classList.add('is-active');

        if (wrap) {
          const rect = wrap.getBoundingClientRect();
          if (rect.top < 80 || rect.bottom > window.innerHeight) {
            wrap.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
        }
      });
    });

    // 4. Initialize visible lecture players for watch monitoring
    initVisiblePlayers();
  }

  setupChapterRowTrackers();
  document.addEventListener('astro:page-load', () => {
    activeTimers.forEach((timer) => clearInterval(timer));
    activeTimers.clear();
    activePlayers.clear();
    pendingSeeks.clear();
    setupChapterRowTrackers();
  });
</script>
