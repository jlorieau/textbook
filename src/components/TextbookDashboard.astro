---
// src/components/TextbookDashboard.astro
import { quantumMechanicsBook } from '../data/books/quantum-mechanics';
import { thermodynamicsBook } from '../data/books/thermodynamics';

const qmSlugs = quantumMechanicsBook.chapters.flatMap((ch, idx) => {
  const s = [`${quantumMechanicsBook.id}-ch${idx + 1}-${ch.id}`];
  if (ch.problemSet) s.push(`${quantumMechanicsBook.id}-ps${idx + 1}-${ch.id}`);
  return s;
});

const thermoSlugs = thermodynamicsBook.chapters.flatMap((ch, idx) => {
  const s = [`${thermodynamicsBook.id}-ch${idx + 1}-${ch.id}`];
  if (ch.problemSet) s.push(`${thermodynamicsBook.id}-ps${idx + 1}-${ch.id}`);
  return s;
});

const qmChapterCount = quantumMechanicsBook.chapters.length;
const qmPsCount = quantumMechanicsBook.chapters.filter((c) => Boolean(c.problemSet)).length;

const thermoChapterCount = thermodynamicsBook.chapters.length;
const thermoPsCount = thermodynamicsBook.chapters.filter((c) => Boolean(c.problemSet)).length;
---

<div class="dashboard-hub not-content">
  <div class="textbook-grid">
    <!-- Thermodynamics Card (Precedes QM) -->
    <div class="textbook-card" data-book="thermo">
      <div class="card-inner-flex">
        {thermodynamicsBook.coverImage && (
          <a href="/thermodynamics/" class="card-cover-anchor" title={`Open ${thermodynamicsBook.title}`}>
            <img
              src={thermodynamicsBook.coverImage}
              alt={`${thermodynamicsBook.title} Cover`}
              class="card-cover-media"
              loading="lazy"
              width="135"
              height="180"
            />
          </a>
        )}

        <div class="card-info-col">
          <h3>
            <a href="/thermodynamics/" class="card-title-link">{thermodynamicsBook.title}</a>
          </h3>
          <p class="card-description">{thermodynamicsBook.description}</p>
          
          <div class="card-sub-stats">
            <span>🎬 {thermoChapterCount} Lectures</span>
            <span>✏️ {thermoPsCount} Practice Sets</span>
          </div>

          <div class="dashboard-progress">
            <div class="progress-bar-container">
              <div class="progress-fill thermo-fill" id="thermo-progress-fill"></div>
            </div>
            <div class="progress-text" id="thermo-progress-text">0 / {thermoSlugs.length} Modules Completed (0%)</div>
          </div>

          <div class="card-actions">
            <a href="/thermodynamics/" class="btn-primary">Open Textbook →</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Quantum Mechanics Card -->
    <div class="textbook-card" data-book="qm">
      <div class="card-inner-flex">
        {quantumMechanicsBook.coverImage && (
          <a href="/quantum-mechanics/" class="card-cover-anchor" title={`Open ${quantumMechanicsBook.title}`}>
            <img
              src={quantumMechanicsBook.coverImage}
              alt={`${quantumMechanicsBook.title} Cover`}
              class="card-cover-media"
              loading="lazy"
              width="135"
              height="180"
            />
          </a>
        )}

        <div class="card-info-col">
          <h3>
            <a href="/quantum-mechanics/" class="card-title-link">{quantumMechanicsBook.title}</a>
          </h3>
          <p class="card-description">{quantumMechanicsBook.description}</p>
          
          <div class="card-sub-stats">
            <span>🎬 {qmChapterCount} Lectures</span>
            <span>✏️ {qmPsCount} Practice Sets</span>
          </div>

          <div class="dashboard-progress">
            <div class="progress-bar-container">
              <div class="progress-fill qm-fill" id="qm-progress-fill"></div>
            </div>
            <div class="progress-text" id="qm-progress-text">0 / {qmSlugs.length} Modules Completed (0%)</div>
          </div>

          <div class="card-actions">
            <a href="/quantum-mechanics/" class="btn-primary">Open Textbook →</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="dashboard-footer">
    <a href="/about/" class="btn-colophon-link">
      <span>ℹ️ About & Colophon</span>
    </a>
    <button type="button" id="reset-all-btn" class="btn-reset">
      ↻ Reset All Course Progress
    </button>
  </div>
</div>

<style>
  .dashboard-hub {
    margin: 0.25rem 0 0.75rem 0;
  }
  .textbook-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    margin-bottom: 1.25rem;
    align-items: stretch;
  }
  @media (max-width: 680px) {
    .textbook-grid {
      grid-template-columns: 1fr;
    }
  }
  .textbook-card {
    margin: 0 !important;
    padding: 1.15rem 1.25rem;
    border-radius: 12px;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-5);
    display: flex;
    flex-direction: column;
    height: 100%;
    box-sizing: border-box;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .textbook-card:hover {
    transform: translateY(-2px);
    border-color: var(--sl-color-accent);
  }
  .card-inner-flex {
    display: flex;
    gap: 1.15rem;
    align-items: stretch;
    height: 100%;
  }
  .card-cover-anchor {
    display: block;
    width: 125px;
    flex-shrink: 0;
    aspect-ratio: 3 / 4;
    border-radius: 8px;
    overflow: hidden;
    background: #000000;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.45);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    align-self: flex-start;
  }
  .card-cover-anchor:hover {
    transform: scale(1.03);
    box-shadow: 0 6px 22px rgba(0, 0, 0, 0.7);
    border-color: var(--sl-color-accent);
  }
  .card-cover-media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .card-info-col {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-width: 0;
    height: 100%;
  }
  @media (max-width: 580px) {
    .card-inner-flex {
      flex-direction: column;
      align-items: center;
    }
    .card-cover-anchor {
      width: 150px;
      margin-bottom: 0.75rem;
      align-self: center;
    }
  }
  .card-badge {
    display: inline-block;
    font-size: 0.74rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 5px;
    margin-bottom: 0.45rem;
    width: fit-content;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .qm-badge {
    background: var(--qp-badge-blue-bg);
    color: var(--qp-badge-blue-text);
    border: 1px solid var(--qp-badge-blue-border);
  }
  .thermo-badge {
    background: var(--qp-badge-amber-bg);
    color: var(--qp-badge-amber-text);
    border: 1px solid var(--qp-badge-amber-border);
  }
  .textbook-card h3 {
    margin: 0 0 0.35rem 0 !important;
    font-size: 1.25rem;
    font-weight: 700;
  }
  .card-title-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .card-title-link:hover {
    color: var(--sl-color-accent);
  }
  .card-description {
    font-size: 0.88rem;
    color: var(--sl-color-gray-2);
    margin: 0 0 0.75rem 0 !important;
    line-height: 1.45;
    flex-grow: 1;
  }
  .card-sub-stats {
    display: flex;
    gap: 0.85rem;
    font-size: 0.82rem;
    color: var(--sl-color-gray-3);
    margin-bottom: 0.75rem;
    font-weight: 600;
  }
  .dashboard-progress {
    margin-bottom: 0.85rem;
  }
  .progress-bar-container {
    width: 100%;
    height: 6px;
    background: var(--sl-color-gray-5);
    border-radius: 9999px;
    overflow: hidden;
    margin-bottom: 0.35rem;
  }
  .progress-fill {
    height: 100%;
    width: 0%;
    border-radius: 9999px;
    transition: width 0.4s ease;
  }
  .qm-fill {
    background: linear-gradient(90deg, #0284c7, #38bdf8);
  }
  .thermo-fill {
    background: linear-gradient(90deg, #d97706, #fbbf24);
  }
  .progress-text {
    font-size: 0.78rem;
    color: var(--sl-color-gray-3);
  }
  .card-actions {
    margin-top: auto;
  }
  .btn-primary {
    display: block;
    text-align: center;
    width: 100%;
    padding: 0.5rem 1rem;
    border-radius: 7px;
    background: var(--sl-color-accent);
    color: var(--sl-color-black) !important;
    font-weight: 600;
    font-size: 0.88rem;
    text-decoration: none !important;
    transition: opacity 0.2s ease, transform 0.15s ease;
  }
  .btn-primary:hover {
    opacity: 0.92;
    transform: translateY(-1px);
  }
  .dashboard-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--sl-color-gray-5);
  }
  .btn-colophon-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--sl-color-gray-3);
    font-size: 0.8rem;
    text-decoration: none !important;
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
    transition: color 0.15s ease;
  }
  .btn-colophon-link:hover {
    color: var(--sl-color-accent);
  }
  .btn-colophon-link .sub-colophon {
    font-size: 0.75rem;
    opacity: 0.7;
  }
  .btn-reset {
    background: transparent;
    border: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-gray-3);
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    font-size: 0.78rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .btn-reset:hover {
    color: #ef4444;
    border-color: #ef4444;
  }
</style>

<script define:vars={{ qmSlugs, thermoSlugs }}>
  function updateDashboard() {
    function computeBook(slugs) {
      let count = 0;
      slugs.forEach((slug) => {
        if (localStorage.getItem(`qp_watched_${slug}`) === 'true') {
          count++;
        }
      });
      return {
        completed: count,
        total: slugs.length,
        pct: slugs.length ? Math.round((count / slugs.length) * 100) : 0,
      };
    }

    const qmData = computeBook(qmSlugs);
    const thermoData = computeBook(thermoSlugs);

    const qmFill = document.getElementById('qm-progress-fill');
    const qmText = document.getElementById('qm-progress-text');
    if (qmFill) qmFill.style.width = `${qmData.pct}%`;
    if (qmText) qmText.textContent = `${qmData.completed} / ${qmData.total} Modules Completed (${qmData.pct}%)`;

    const thermoFill = document.getElementById('thermo-progress-fill');
    const thermoText = document.getElementById('thermo-progress-text');
    if (thermoFill) thermoFill.style.width = `${thermoData.pct}%`;
    if (thermoText) thermoText.textContent = `${thermoData.completed} / ${thermoData.total} Modules Completed (${thermoData.pct}%)`;
  }

  function setupDashboard() {
    updateDashboard();

    const resetBtn = document.getElementById('reset-all-btn');
    resetBtn?.addEventListener('click', () => {
      if (confirm('Are you sure you want to reset your local progress for all textbooks?')) {
        [...qmSlugs, ...thermoSlugs].forEach((slug) => {
          localStorage.removeItem(`qp_watched_${slug}`);
        });
        updateDashboard();
        window.dispatchEvent(new CustomEvent('qp:progress-update'));
      }
    });

    window.addEventListener('qp:progress-update', updateDashboard);
  }

  setupDashboard();
  document.addEventListener('astro:page-load', setupDashboard);
</script>
