---
// src/components/TimestampLink.astro
interface Props {
  videoId: string;
  seconds: number;
  label: string;
}

const { videoId, seconds, label } = Astro.props;
const url = `https://youtu.be/${videoId}?t=${seconds}`;
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="timestamp-chip"
  title={`Jump to ${label} on YouTube`}
>
  <span>⏱</span>
  <span>{label}</span>
  <span style="font-size: 0.75rem; opacity: 0.7;">↗</span>
</a>
