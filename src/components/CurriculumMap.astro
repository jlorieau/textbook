---
// src/components/CurriculumMap.astro
import type { BookData } from '../types/book';

interface Props {
  book: BookData;
}

const { book } = Astro.props;
---

<div class={`curriculum-map-flow not-content book-theme-${book.colorScheme}`}>
  <div class="map-spine">
    {book.chapters.map((chapter, idx) => {
      const showPartHeading = chapter.part && (idx === 0 || book.chapters[idx - 1].part !== chapter.part);
      const isLast = idx === book.chapters.length - 1;

      return (
        <Fragment key={chapter.id}>
          {showPartHeading && (
            <div class="map-part-milestone-row">
              <div class="map-part-milestone-pill">
                <span class="milestone-text">{chapter.part}</span>
              </div>
            </div>
          )}

          <!-- Step Row: Chapter Node + optional Problem Set Node -->
          <div class="map-step-row" id={`map-ch-${idx + 1}`}>
            <!-- Column 1: Main Concept Lecture Node -->
            <div class="map-card map-lecture-card">
              <div class="map-card-header">
                <span class="map-card-badge">Chapter {idx + 1}</span>
                <h3 class="map-card-title">{chapter.title}</h3>
              </div>
              <div class="map-video-frame">
                {chapter.youtubeId ? (
                  <iframe
                    src={`https://www.youtube.com/embed/${chapter.youtubeId}?enablejsapi=1&rel=0&playsinline=1&modestbranding=1`}
                    title={`Chapter ${idx + 1}: ${chapter.title}`}
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    referrerpolicy="strict-origin-when-cross-origin"
                    allowfullscreen
                    class="map-iframe"
                  />
                ) : (
                  <div class="map-placeholder">
                    <span>🎬 Video in Final Production</span>
                  </div>
                )}
              </div>
            </div>

            <!-- Column 2 & 3: Branch Connector + Problem Set Node (if present) -->
            {chapter.problemSet ? (
              <>
                <div class="map-branch-connector" aria-hidden="true">
                  <div class="branch-line" />
                  <svg class="branch-arrow" width="22" height="22" viewBox="0 0 24 24" fill="none">
                    <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>

                <div class="map-card map-ps-card">
                  <div class="map-card-header">
                    <span class="map-card-badge map-ps-badge">Problem Set {idx + 1}</span>
                    <h3 class="map-card-title">{chapter.problemSet.title}</h3>
                  </div>
                  <div class="map-video-frame">
                    {chapter.problemSet.youtubeId ? (
                      <iframe
                        src={`https://www.youtube.com/embed/${chapter.problemSet.youtubeId}?enablejsapi=1&rel=0&playsinline=1&modestbranding=1`}
                        title={`Problem Set ${idx + 1}: ${chapter.problemSet.title}`}
                        loading="lazy"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        referrerpolicy="strict-origin-when-cross-origin"
                        allowfullscreen
                        class="map-iframe"
                      />
                    ) : (
                      <div class="map-placeholder">
                        <span>✏️ Problem Set Coming Soon</span>
                      </div>
                    )}
                  </div>
                </div>
              </>
            ) : (
              <div class="map-branch-spacer" aria-hidden="true" />
            )}
          </div>

          <!-- Downward Arrow Connector to Next Chapter -->
          {!isLast && (
            <div class="map-trunk-row" aria-hidden="true">
              <div class="map-trunk-connector">
                <div class="trunk-line" />
                <svg class="trunk-arrow" width="22" height="22" viewBox="0 0 24 24" fill="none">
                  <path d="M12 5v14M6 13l6 6 6-6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            </div>
          )}
        </Fragment>
      );
    })}
  </div>
</div>

<style>
  .curriculum-map-flow {
    width: 100%;
    margin: 1.5rem 0 3rem 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    padding: 0.5rem 0.5rem 2rem 0.5rem;
  }

  .map-spine {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 740px;
    margin: 0 auto;
  }

  /* Part / Milestone Row */
  .map-part-milestone-row {
    display: grid;
    grid-template-columns: 330px 64px 330px;
    justify-content: center;
    margin: 2.25rem 0 1.25rem 0;
  }

  .map-part-milestone-row:first-child {
    margin-top: 0.5rem;
  }

  .map-part-milestone-pill {
    grid-column: 1;
    width: 330px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.7rem 1.15rem;
    border-radius: 12px;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-5);
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--sl-color-white);
    letter-spacing: 0.01em;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
    text-align: center;
    line-height: 1.35;
  }

  .book-theme-amber .map-part-milestone-pill {
    border-color: rgba(217, 119, 6, 0.35);
  }

  .book-theme-blue .map-part-milestone-pill {
    border-color: rgba(2, 132, 199, 0.35);
  }

  :root[data-theme='light'] .map-part-milestone-pill {
    background: #ffffff;
    border-color: var(--sl-color-gray-5);
    color: var(--sl-color-black);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  :root[data-theme='light'] .book-theme-amber .map-part-milestone-pill {
    border-color: rgba(217, 119, 6, 0.3);
  }

  :root[data-theme='light'] .book-theme-blue .map-part-milestone-pill {
    border-color: rgba(2, 132, 199, 0.3);
  }

  /* Step Grid Row */
  .map-step-row {
    display: grid;
    grid-template-columns: 330px 64px 330px;
    align-items: center;
    justify-content: center;
    scroll-margin-top: calc(var(--sl-nav-height) + 2rem);
  }

  /* Card Node */
  .map-card {
    width: 330px;
    box-sizing: border-box;
    padding: 0.95rem 1rem 1rem 1rem;
    border-radius: 14px;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-5);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .map-card:hover {
    transform: translateY(-2px);
    border-color: var(--sl-color-accent);
    box-shadow: 0 8px 26px rgba(0, 0, 0, 0.35);
  }

  :root[data-theme='light'] .map-card {
    background: #ffffff;
    border-color: var(--sl-color-gray-5);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
  }

  :root[data-theme='light'] .map-card:hover {
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.1);
  }

  /* Card Header: Strictly ONLY badge and title */
  .map-card-header {
    margin-bottom: 0.65rem;
    min-height: 58px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .map-card-badge {
    display: inline-block;
    align-self: flex-start;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.15rem 0.55rem;
    border-radius: 6px;
    margin-bottom: 0.35rem;
    background: var(--qp-badge-blue-bg);
    color: var(--qp-badge-blue-text);
    border: 1px solid var(--qp-badge-blue-border);
  }

  .book-theme-amber .map-card-badge {
    background: var(--qp-badge-amber-bg);
    color: var(--qp-badge-amber-text);
    border-color: var(--qp-badge-amber-border);
  }

  .map-card-badge.map-ps-badge {
    background: rgba(16, 185, 129, 0.16);
    color: #34d399;
    border-color: rgba(16, 185, 129, 0.35);
  }

  :root[data-theme='light'] .map-card-badge.map-ps-badge {
    background: rgba(16, 185, 129, 0.12);
    color: #059669;
    border-color: rgba(16, 185, 129, 0.3);
  }

  .map-card-title {
    margin: 0 !important;
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--sl-color-white);
    letter-spacing: -0.01em;
  }

  :root[data-theme='light'] .map-card-title {
    color: var(--sl-color-black);
  }

  /* Embedded Video Frame */
  .map-video-frame {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 8px;
    overflow: hidden;
    background: #000000;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .map-iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  .map-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.82rem;
    color: var(--sl-color-gray-3);
    text-align: center;
    padding: 1rem;
    background: rgba(15, 23, 42, 0.6);
  }

  /* Right Connector (pointing from Lecture to Problem Set) */
  .map-branch-connector {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    padding: 0 4px;
    box-sizing: border-box;
  }

  .branch-line {
    flex: 1;
    height: 2.5px;
    background: var(--sl-color-gray-4);
    border-radius: 9999px;
  }

  .branch-arrow {
    flex-shrink: 0;
    color: var(--sl-color-gray-3);
    margin-left: -5px;
  }

  .book-theme-amber .branch-line {
    background: linear-gradient(90deg, rgba(217, 119, 6, 0.45) 0%, rgba(251, 191, 36, 0.85) 100%);
  }
  .book-theme-amber .branch-arrow {
    color: #fbbf24;
  }

  .book-theme-blue .branch-line {
    background: linear-gradient(90deg, rgba(2, 132, 199, 0.45) 0%, rgba(56, 189, 248, 0.85) 100%);
  }
  .book-theme-blue .branch-arrow {
    color: #38bdf8;
  }

  /* Empty Spacer to preserve grid alignment when no Problem Set */
  .map-branch-spacer {
    grid-column: 2 / span 2;
  }

  /* Vertical Downward Trunk Connector */
  .map-trunk-row {
    display: grid;
    grid-template-columns: 330px 64px 330px;
    justify-content: center;
  }

  .map-trunk-connector {
    grid-column: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 48px;
  }

  .trunk-line {
    width: 2.5px;
    height: 28px;
    background: var(--sl-color-gray-4);
    border-radius: 9999px;
  }

  .trunk-arrow {
    color: var(--sl-color-gray-3);
    margin-top: -5px;
  }

  .book-theme-amber .trunk-line {
    background: linear-gradient(180deg, rgba(217, 119, 6, 0.45) 0%, rgba(251, 191, 36, 0.85) 100%);
  }
  .book-theme-amber .trunk-arrow {
    color: #fbbf24;
  }

  .book-theme-blue .trunk-line {
    background: linear-gradient(180deg, rgba(2, 132, 199, 0.45) 0%, rgba(56, 189, 248, 0.85) 100%);
  }
  .book-theme-blue .trunk-arrow {
    color: #38bdf8;
  }

  @media (max-width: 768px) {
    .curriculum-map-flow {
      padding: 0.5rem 0.25rem 2rem 0.25rem;
    }
  }
</style>
